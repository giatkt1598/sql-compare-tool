{
  "name": "sql-comparer",
  "version": "1.0.0",
  "description": "Tool full-stack để so sánh kết quả của 2 câu SQL (old vs new) theo nhiều test case đầu vào.",
  "license": "ISC",
  "author": "",
  "type": "module",
  "scripts": {
    "dev": "cd server && npm run dev:fullstack",
