{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Server: Dev (nodemon)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm.cmd",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}/server",
      "console": "integratedTerminal",
      "env": {
        "PORT": "5000"
      },
      "restart": true,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Server: Debug index.ts (tsx)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "runtimeArgs": ["./node_modules/tsx/dist/cli.mjs", "src/index.ts"],
      "cwd": "${workspaceFolder}/server",
      "console": "integratedTerminal",
      "env": {
        "PORT": "5000"
      },
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
